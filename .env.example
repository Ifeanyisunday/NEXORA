
# Nexora local development configuration
# Replace placeholders in your private local environment.
# Never put actual credentials in this file.

DB_URL=jdbc:postgresql://localhost:5432/nexoradb
DB_USERNAME=your_local_database_user
DB_PASSWORD=replace_with_your_local_database_password

JWT_SECRET=replace_with_a_generated_random_secret

# Automated testing
TEST_DB_URL=jdbc:postgresql://localhost:5432/nexora_test
TEST_DB_USERNAME=your_test_database_user
TEST_DB_PASSWORD=replace_with_your_test_database_password
TEST_JWT_SECRET=replace_with_a_separate_test_secret
